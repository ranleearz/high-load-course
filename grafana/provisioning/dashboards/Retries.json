      "title": "Повторные вызовы в секунду (по причине предыдущей неудачи)",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(payment_retry_total{service=~\"$service\"}[30s]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Повторные вызовы и все попытки с запуска сервиса",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "C",
          "expr": "sum(payment_retry_total{service=~\"$service\"})",
          "legendFormat": "повторов всего",
          "instant": true
        },
        {
          "refId": "A",
          "expr": "sum by (reason) (payment_retry_total{service=~\"$service\"})",
          "legendFormat": "{{reason}}",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(payment_attempt_duration_seconds_count{service=~\"$service\"})",
          "legendFormat": "всего попыток",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
